---
import { SITE } from '../data/site';
import ContactLink from './ContactLink.astro';
---

<!-- The color-insert page: full-bleed cyan CTA -->
<section id="contact" class="scroll-mt-20 border-b-[3px] border-ink bg-cyan">
  <div class="mx-auto max-w-6xl px-4 py-20 text-center">
    <p class="tag">07 — Final Page</p>
    <h2 class="display mt-5 text-5xl md:text-7xl">
      <span class="skew">Let's</span> <span class="skew">Talk.</span>
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-sm font-black uppercase tracking-wide">
      Looking for a backend developer who ships. Based in Mandaluyong, Metro Manila — open to
      remote and onsite roles.
    </p>
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      <ContactLink label="Email" value={SITE.email} href={`mailto:${SITE.email}`} icon="tabler:mail" breakAll />
      <ContactLink label="LinkedIn" value="in/ralph-abejuela" href={SITE.linkedin} icon="tabler:brand-linkedin" />
      <ContactLink label="GitHub" value="@ralph-abejuela" href={SITE.github} icon="tabler:brand-github" />
    </div>
  </div>
</section>
