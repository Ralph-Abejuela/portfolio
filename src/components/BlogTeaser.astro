---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<section id="blog" class="relative scroll-mt-20 overflow-clip border-b-[3px] border-ink">
  <div class="halftone mask-l absolute inset-y-0 left-0 z-0 hidden w-1/4 opacity-30 md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <SectionHeader number="05" title="Blog" />
      <a href="/blog" class="btn">All Posts <Icon name="tabler:arrow-right" size={16} /></a>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        posts.slice(0, 3).map((post, i) => (
          <a
            href={`/blog/${post.id}`}
            class={`reveal panel panel-hover block p-6 ${i === 1 ? 'md:mt-8' : ''}`}
          >
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-[0.65rem] font-black uppercase tracking-widest"
            >
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h3 class="display mt-3 text-xl">{post.data.title}</h3>
            <p class="mt-2 text-sm font-medium">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
