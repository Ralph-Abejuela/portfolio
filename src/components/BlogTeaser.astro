---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<section id="blog" class="relative scroll-mt-20 overflow-hidden border-t-2 border-ink">
  <div class="tone tone-hatch tone-edge-r tone-mask-l hidden md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-4xl px-4 py-16">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <SectionHeader number="05" title="Blog" />
      <a href="/blog" class="btn">All Posts <Icon name="tabler:arrow-right" size={16} /></a>
    </div>
    <div class="mt-10 space-y-6">
      {
        posts.slice(0, 3).map((post) => (
          <a href={`/blog/${post.id}`} class="reveal card card-hover block p-6">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-[0.65rem] font-bold uppercase tracking-widest"
            >
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h3 class="mt-2 font-display text-lg font-extrabold">{post.data.title}</h3>
            <p class="mt-1 text-sm">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
