---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { SITE } from '../data/site';
---

<section id="hero" class="relative overflow-clip border-b-[3px] border-ink">
  <!-- Layer 1: halftone field (parallax, slow) -->
  <div class="halftone-lg mask-b absolute inset-0 z-0 opacity-60 plx-slow" aria-hidden="true"></div>
  <!-- Layer 2: horizontal speed-line band (parallax, fast) — lines start at section top, fade down -->
  <div class="speed-lines mask-t absolute inset-x-0 top-0 z-0 h-48 opacity-25 plx" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid max-w-6xl gap-10 px-4 pb-20 pt-14 md:grid-cols-12 md:items-center md:gap-14 md:pt-24">
    <!-- Title block (below headshot on mobile) -->
    <div class="order-2 text-center md:order-1 md:col-span-7 md:text-left">
      <div class="flex flex-wrap items-center justify-center gap-3 md:justify-start">
        <p class="tag">Portfolio — 2026</p>
        <p class="flex -rotate-2 items-center gap-2 border-2 border-ink bg-cyan px-3 py-1.5 text-xs font-black uppercase tracking-widest text-ink shadow-[3px_3px_0_var(--shadow)]">
          <span class="pulse-dot h-2.5 w-2.5 rounded-full bg-accent-foreground"></span>
          Available for work
        </p>
      </div>

      <h1 class="display mt-7 text-[clamp(2.75rem,10vw,6.5rem)] leading-[0.88]">
        <span class="skew">Ralph</span>
        <span class="relative inline-block skew">
          <span
            class="absolute inset-x-0 top-1/2 h-[0.1em] -translate-y-1/2 bg-cyan"
            aria-hidden="true"
          ></span>
          <span class="relative">Abejuela</span>
        </span>
      </h1>

      <p class="display skew mt-5 text-lg tracking-wide text-ink md:text-2xl">
        Fullstack Developer <span class="text-cyan">/</span> <span class="whitespace-nowrap">Mandaluyong, PH</span>
      </p>

      <div class="bubble mx-auto mt-7 max-w-lg text-sm font-semibold leading-relaxed md:mx-0">
        {SITE.tagline}
      </div>

      <div class="mt-9 flex flex-wrap justify-center gap-4 md:justify-start">
        <a href="#projects" class="btn">
          View Projects <Icon name="tabler:arrow-right" size={16} />
        </a>
        <a href="/resume.pdf" target="_blank" rel="noopener" class="btn">
          Resume <Icon name="tabler:file-text" size={16} />
        </a>
        <a href="#contact" class="btn btn-cyan">
          Contact Me <Icon name="tabler:mail" size={16} />
        </a>
      </div>

      <p class="mt-8 flex flex-wrap justify-center gap-3 text-xs font-bold uppercase tracking-widest md:justify-start">
        <a href={SITE.github} class="flex items-center gap-1.5 border-2 border-ink bg-paper px-2 py-1 hover:bg-cyan">
          <Icon name="tabler:brand-github" size={15} /> GitHub
        </a>
        <a href={SITE.linkedin} class="flex items-center gap-1.5 border-2 border-ink bg-paper px-2 py-1 hover:bg-cyan">
          <Icon name="tabler:brand-linkedin" size={15} /> LinkedIn
        </a>
        <a href={`mailto:${SITE.email}`} class="flex items-center gap-1.5 border-2 border-ink bg-paper px-2 py-1 hover:bg-cyan">
          <Icon name="tabler:mail" size={15} /> Email
        </a>
      </p>
    </div>

    <!-- Panel scene: speed burst + headshot (first + small on mobile) -->
    <figure class="relative order-1 mx-auto w-full max-w-[10rem] sm:max-w-[13rem] md:order-2 md:col-span-5 md:ml-4 md:max-w-full lg:ml-8">
      <div class="speed-burst mask-burst pointer-events-none absolute -inset-8 z-0 plx" aria-hidden="true"></div>
      <div class="splatter pointer-events-none absolute -bottom-7 -left-7 z-0 h-32 w-48 opacity-70" aria-hidden="true"></div>
      <div class="panel relative z-10 p-3">
        <Image
          src="/images/headshot.jpg"
          alt={`Portrait of ${SITE.name}`}
          width={800}
          height={800}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
      <figcaption class="tag relative z-10 mt-5 hidden md:block">Fig.01 — Ralph Abejuela, 2026</figcaption>
    </figure>
  </div>
</section>
