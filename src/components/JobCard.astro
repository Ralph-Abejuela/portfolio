---
import type { ExperienceItem } from '../data/experience';

interface Props {
  job: ExperienceItem;
}
const { job } = Astro.props;
---

<div class="reveal panel p-6 md:p-7">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b-2 border-ink pb-3">
    <h3 class="display text-xl md:text-2xl">
      {job.role} <span class="skew text-sm font-black normal-case tracking-normal">— {job.org}</span>
    </h3>
    <p class="text-[0.65rem] font-black uppercase tracking-widest">{job.dates}</p>
  </div>
  <p class="skew mt-2 text-[0.7rem] font-black uppercase tracking-widest">▸ {job.location}</p>
  <ul class="mt-4 list-disc space-y-2 pl-5 text-sm font-medium leading-relaxed">
    {job.points.map((pt) => <li>{pt}</li>)}
  </ul>
</div>
