---
import type { ExperienceItem } from '../data/experience';

interface Props {
  job: ExperienceItem;
}
const { job } = Astro.props;
---

<div class="reveal card p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b-2 border-ink pb-2">
    <h3 class="font-display text-lg font-extrabold">
      {job.role} <span class="font-bold normal-case tracking-normal">— {job.org}</span>
    </h3>
    <p class="text-[0.65rem] font-bold uppercase tracking-widest">{job.dates}</p>
  </div>
  <p class="mt-2 text-[0.7rem] font-bold uppercase tracking-widest">▸ {job.location}</p>
  <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
    {job.points.map((p) => <li>{p}</li>)}
  </ul>
</div>
