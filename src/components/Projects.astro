---
import { projects } from '../data/projects';
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectModal from '@/islands/ProjectModal';
import { Icon } from 'astro-icon/components';
---

<section id="projects" class="relative scroll-mt-20 overflow-clip border-b-[3px] border-ink">
  <div class="halftone-lg mask-r absolute inset-y-0 right-0 z-0 hidden w-1/3 opacity-40 md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <SectionHeader number="01" title="Featured Works" />
      <a href="/projects" class="btn">
        See more <Icon name="tabler:arrow-right" size={16} />
      </a>
    </div>
    <div class="mt-12 grid grid-cols-12 gap-3 bg-ink p-3">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </div>
  <ProjectModal projects={projects} client:load />
</section>
