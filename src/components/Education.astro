---
import { education } from '../data/education';
import SectionHeader from './SectionHeader.astro';
---

<section id="education" class="relative scroll-mt-20 overflow-clip border-b-[3px] border-ink">
  <div class="halftone-lg mask-r absolute inset-y-0 right-0 z-0 hidden w-1/3 opacity-35 md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16">
    <SectionHeader number="04" title="Education" />
    <div class="reveal panel panel-cyan mt-12 max-w-2xl p-6 md:p-8">
      <h3 class="display text-2xl md:text-3xl">{education.school}</h3>
      <p class="skew mt-2 text-sm font-black uppercase tracking-wide">{education.degree}</p>
      <p class="absolute -right-4 -top-4 -rotate-6 border-2 border-white/80 bg-night px-4 py-2 text-center text-[0.65rem] font-black uppercase leading-tight tracking-widest text-moon shadow-[4px_4px_0_var(--foreground)]">
        {education.honor.split(' — ')[0]}
        <span class="mx-auto my-1 block h-px w-5 bg-white/50" aria-hidden="true"></span>
        {education.honor.split(' — ')[1]}
      </p>
      <p class="mt-2 text-[0.65rem] font-black uppercase tracking-widest">{education.dates}</p>
    </div>
  </div>
</section>
