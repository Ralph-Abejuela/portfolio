---
import { interests } from '../data/interests';
import SectionHeader from './SectionHeader.astro';
import Chip from './Chip.astro';
---

<section id="interests" class="relative scroll-mt-20 overflow-clip border-b-[3px] border-ink">
  <div class="screentone-45 mask-r absolute inset-y-0 right-0 z-0 hidden w-1/4 opacity-20 md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16">
    <SectionHeader number="06" title="Extras" accent />
    <ul class="mt-10 flex flex-wrap gap-3">
      {interests.map((i) => (
        <Chip className="border-2 border-ink bg-paper px-3 py-1.5 text-xs font-black uppercase tracking-wide hover:bg-cyan" label={i} />
      ))}
    </ul>
  </div>
</section>
