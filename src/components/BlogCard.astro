---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import TagChip from './TagChip.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
---

<article class="reveal panel panel-hover p-6">
  <a href={`/blog/${post.id}`} class="block">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="text-[0.65rem] font-black uppercase tracking-widest"
    >
      {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <h2 class="display mt-3 text-2xl">{post.data.title}</h2>
    <p class="mt-2 text-sm font-medium">{post.data.description}</p>
  </a>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      post.data.tags.map((t) => (
        <TagChip
          tag={t}
          className="border-2 border-ink bg-paper px-2 py-0.5 text-[0.65rem] font-black uppercase tracking-widest hover:bg-cyan"
        />
      ))
    }
  </ul>
</article>
