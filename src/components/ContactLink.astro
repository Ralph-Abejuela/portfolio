---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  value: string;
  href: string;
  breakAll?: boolean;
  icon?: string;
}
const { label, value, href, breakAll = false, icon } = Astro.props;
---

<a href={href} class="card card-hover block p-6">
  {icon && <Icon name={icon} size={28} class="mx-auto mb-2 block" />}
  <p class="text-[0.65rem] font-bold uppercase tracking-widest">{label}</p>
  <p class={`mt-2${breakAll ? ' break-all' : ''} text-xs font-bold`}>{value}</p>
</a>
