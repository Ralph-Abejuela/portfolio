---
import { Icon } from 'astro-icon/components';
import { SITE } from '../data/site';

const navLinks = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#skills', label: 'Skills' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contact', label: 'Contact' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-paper">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4" aria-label="Main">
    <a href="/" class="display skew bg-cyan px-2 py-1 text-xl text-ink">
      {SITE.firstName}
      <span class="text-ink">.</span></a
    >
    <input type="checkbox" id="nav-toggle" class="peer sr-only" />
    <ul
      class="ml-auto hidden items-center gap-1 text-xs font-black uppercase tracking-widest md:flex"
      id="nav-menu"
    >
      {
        navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-a text-ink"
              aria-current={current.startsWith('/blog') && l.href.startsWith('/blog') ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2 md:ml-4">
      <input type="checkbox" id="theme-toggle" class="sr-only" />
      <label
        for="theme-toggle"
        class="flex h-9 w-9 cursor-pointer items-center justify-center border-2 border-ink bg-paper text-ink hover:bg-cyan"
        aria-label="Toggle night mode"
        title="Night mode"
      >
        <Icon name="tabler:moon" size={18} class="icon-moon" />
        <Icon name="tabler:sun" size={18} class="icon-sun" />
      </label>
      <label
        for="nav-toggle"
        class="flex h-9 w-9 cursor-pointer items-center justify-center border-2 border-ink bg-paper text-lg font-black md:!hidden"
        aria-label="Toggle menu"
        >&#9776;</label
      >
    </div>
    <ul
      class="absolute inset-x-0 top-16 hidden flex-col gap-1 border-b-[3px] border-ink bg-paper px-4 py-4 text-xs font-black uppercase tracking-widest peer-checked:flex md:!hidden"
    >
      {
        navLinks.map((l) => (
          <li>
            <a href={l.href} class="nav-a block text-ink">{l.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
