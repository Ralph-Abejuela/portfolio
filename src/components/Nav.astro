---
import { SITE } from '../data/site';
import ThemeToggle from '@/islands/ThemeToggle';
import MobileMenu from '@/islands/MobileMenu';

const navLinks = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#skills', label: 'Skills' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contact', label: 'Contact' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-paper">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4" aria-label="Main">
    <a href="/" class="display skew bg-cyan px-2 py-1 text-xl text-ink">
      {SITE.firstName}
      <span class="text-ink">.</span></a
    >
    <ul
      class="ml-auto hidden items-center gap-1 text-sm font-black uppercase tracking-widest md:flex"
      id="nav-menu"
    >
      {
        navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-a text-ink"
              aria-current={current.startsWith('/blog') && l.href.startsWith('/blog') ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2 md:ml-4">
      <ThemeToggle client:load />
      <MobileMenu client:load links={navLinks} />
    </div>
  </nav>
</header>
