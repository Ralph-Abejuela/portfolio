---
import { experience } from '../data/experience';
import SectionHeader from './SectionHeader.astro';
import JobCard from './JobCard.astro';
---

<section id="experience" class="relative scroll-mt-20 overflow-hidden border-t-2 border-ink">
  <div class="tone tone-dots tone-edge-l tone-mask-r hidden md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-4xl px-4 py-16">
    <SectionHeader number="02" title="Experience" accent />
    <div class="mt-10 space-y-8">
      {experience.map((job) => <JobCard job={job} />)}
    </div>
  </div>
</section>
