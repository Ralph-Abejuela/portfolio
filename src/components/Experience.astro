---
import { experience } from '../data/experience';
import SectionHeader from './SectionHeader.astro';
import JobCard from './JobCard.astro';
---

<section id="experience" class="relative scroll-mt-20 overflow-clip border-b-[3px] border-ink">
  <div class="halftone mask-r absolute inset-y-0 right-0 z-0 hidden w-1/3 opacity-30 md:block" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16">
    <SectionHeader number="02" title="Experience" />
    <div class="mt-12 space-y-8">
      {experience.map((job) => <JobCard job={job} />)}
    </div>
  </div>
</section>
