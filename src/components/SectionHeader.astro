---
interface Props {
  number: string;
  title: string;
  accent?: boolean;
}
const { number, title, accent = false } = Astro.props;
---

<div class="flex items-center gap-4">
  <span class={`tag${accent ? ' tag-cyan' : ''}`}>{number}</span>
  <h2 class="display skew text-3xl md:text-4xl">{title}</h2>
  <span class="speed-lines h-3 min-w-6 flex-1 opacity-20" aria-hidden="true"></span>
</div>
