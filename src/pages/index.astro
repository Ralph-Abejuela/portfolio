---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Interests from '../components/Interests.astro';
import Contact from '../components/Contact.astro';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  description: SITE.tagline,
  email: `mailto:${SITE.email}`,
  url: SITE.url,
  image: `${SITE.url}/images/headshot.jpg`,
  sameAs: [SITE.linkedin, SITE.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mandaluyong',
    addressRegion: 'Metro Manila',
    addressCountry: 'PH',
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'STI College Legazpi' },
  knowsAbout: SITE.skills,
};
---

<BaseLayout
  title={`${SITE.name} — ${SITE.role}`}
  description={SITE.description}
  jsonLd={personLd}
>
  <Hero />
  <Projects />
  <Experience />
  <Skills />
  <Education />
  <BlogTeaser />
  <Interests />
  <Contact />
</BaseLayout>
