---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import TagChip from '../../components/TagChip.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const otherPosts = (await getCollection('blog')).filter((p) => p.id !== post.id);

const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.name },
  mainEntityOfPage: `${SITE.url}/blog/${post.id}`,
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} | ${SITE.name}`}
  description={post.data.description}
  ogType="article"
  jsonLd={postLd}
>
  <div class="relative z-10 mx-auto grid max-w-6xl gap-10 px-4 py-16 lg:grid-cols-12">
    {
      toc.length > 0 && (
        <nav class="hidden self-start lg:sticky lg:top-24 lg:col-span-3 lg:block" aria-label="Post contents">
          <p class="text-[0.6rem] font-black uppercase tracking-widest opacity-40">Contents</p>
          <ul class="mt-3 space-y-1 border-l-2 border-outline-variant">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="block py-1 pl-3 text-xs font-medium leading-snug opacity-60 transition-opacity hover:opacity-100"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
          {otherPosts.length > 0 && (
            <>
              <p class="mt-8 text-[0.6rem] font-black uppercase tracking-widest opacity-40">More Posts</p>
              <ul class="mt-3 space-y-4 border-l-2 border-outline-variant">
                {otherPosts.map((p) => (
                  <li>
                    <a
                      href={`/blog/${p.id}`}
                      class="block pl-3 text-xs font-medium leading-snug opacity-60 transition-opacity hover:opacity-100"
                    >
                      {p.data.title}
                    </a>
                    <p class="pl-3 text-[0.6rem] font-black uppercase tracking-widest opacity-40">
                      {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </p>
                  </li>
                ))}
              </ul>
            </>
          )}
        </nav>
      )
    }
    <article class="relative mx-auto w-full max-w-3xl lg:col-span-9 lg:mx-0">
      <div class="halftone-fine mask-b absolute inset-0 z-0 opacity-25" aria-hidden="true"></div>
      <div class="relative z-10">
      <a
        href="/blog"
        class="btn inline-flex w-fit items-center gap-1.5 px-3 py-2 text-[0.7rem]"
      >
        <Icon name="tabler:arrow-left" size={14} /> All Posts
      </a>
      <header class="mt-8 border-b-[3px] border-ink pb-8">
        <h1 class="display text-4xl leading-[0.95] md:text-5xl">{post.data.title}</h1>
        <div class="mt-5 flex flex-wrap items-center gap-4 text-[0.65rem] font-black uppercase tracking-widest">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>By {SITE.name}</span>
        </div>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            post.data.tags.map((t) => (
              <TagChip
                tag={t}
                className="border-2 border-ink px-2 py-0.5 text-[0.65rem] font-black uppercase tracking-widest"
              />
            ))
          }
        </ul>
      </header>
      <div class="prose prose-manga mt-10 max-w-none">
        <Content />
      </div>
      </div>
    </article>
  </div>
</BaseLayout>
