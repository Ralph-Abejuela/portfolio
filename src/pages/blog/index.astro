---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={`Blog — ${SITE.name}`}
  description={`Articles by ${SITE.name} on backend development, zero-server architecture, on-device ML, and local LLMs.`}
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
    <p class="mt-2 text-zinc-600">
      Notes on backend development, zero-server architecture, and running AI locally.
    </p>
    <div class="mt-10 space-y-6">
      {
        posts.map((post) => (
          <article class="reveal rounded-xl border border-zinc-200 bg-white p-6 shadow-sm transition hover:border-emerald-600">
            <a href={`/blog/${post.id}`} class="block">
              <time datetime={post.data.pubDate.toISOString()} class="text-sm text-zinc-500">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="mt-1 text-xl font-semibold text-zinc-900 hover:text-emerald-700">{post.data.title}</h2>
              <p class="mt-2 text-zinc-600">{post.data.description}</p>
            </a>
            <ul class="mt-4 flex flex-wrap gap-2">
              {post.data.tags.map((t) => (
                <li class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-800">{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
